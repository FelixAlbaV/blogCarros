---
import Social from './Social.astro';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Carros Blog Felix. All rights reserved.
	<div class="social-links">
		<Social platform="github" username="FelixAlbaV/blogCarros" />
		<Social platform="youtube" username="@CHRISTOPHERFELIXALBAVENTURA" />
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 2rem;
	}
</style>
