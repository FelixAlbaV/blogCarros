---
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
	<p><em>{frontmatter.description}</em></p>
	<p><FormattedDate date={new Date(frontmatter.pubDate)} /></p>

	<p>Escrito por: {frontmatter.author}</p>

	{frontmatter.image?.url && <img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} />}

	{frontmatter.heroImage && (
		<figure class="foto-auto">
			<Image src={frontmatter.heroImage} width={1020} alt={frontmatter.title} />
			{frontmatter.heroImageCredit && <figcaption>{frontmatter.heroImageCredit}</figcaption>}
		</figure>
	)}

	{frontmatter.tags && (
		<div class="tags">
			{frontmatter.tags.map((tag: string) => (
				<p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
			))}
		</div>
	)}

	<slot />
</BaseLayout>

<style>
	.foto-auto {
		margin: 1.5em 0;
	}
	.foto-auto img {
		width: 100%;
		height: auto;
		border-radius: 12px;
	}
	.foto-auto figcaption {
		font-size: 0.75em;
		opacity: 0.7;
		margin-top: 0.25em;
	}
	a {
		color: #00539F;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
	}

	.tag {
		margin: 0.25em;
		border: dotted 1px #a1a1a1;
		border-radius: .5em;
		padding: .5em 1em;
		font-size: 1.15em;
		background-color: #F8FCFD;
	}
</style>
