---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Sobre este blog';
const description = 'Un blog dedicado a los autos deportivos más emocionantes del mundo';

const habilidades = ['Autos deportivos', 'Motores turbo', 'Diseño automotriz', 'Velocidad'];
const feliz = true;
const terminado = false;
const meta = 3;

const colorHabilidad = 'navy';
const pesoHabilidad = 'bold';
const mayusculas = 'uppercase';
---

<BaseLayout pageTitle={pageTitle} description={description}>
  <p>
    Bienvenido a Blog de Autos, un espacio dedicado a los apasionados de los vehículos de alto rendimiento.
    Aquí encontrarás reseñas detalladas, especificaciones técnicas y todo lo que necesitas saber sobre
    los autos deportivos más emocionantes del mercado.
  </p>

  <p>
    Este blog nació de la pasión por los autos y la tecnología automotriz. Cada artículo está escrito
    con el objetivo de compartir información útil y entretenida para quienes, disfrutan
    de la ingeniería y el diseño detrás de cada vehículo.
  </p>

  <p>Temas que cubrimos:</p>
  <ul class="habilidades">
    {habilidades.map(h => <li>{h}</li>)}
  </ul>

  {feliz && <p>Me gustan los carros que te hacen sentir la diversión.</p>}
  {terminado && <p>Los autos cómodos/comerciales son los mejores.</p>}
  {meta === 3 ? <p>Autos para gente purista: hacer cambios y ser uno entre el auto y el conductor.</p> : <p>Mi meta no es 3 días.</p>}
</BaseLayout>

<style is:global define:vars={{ colorHabilidad, pesoHabilidad, mayusculas }}>
  /* is:global: el <h1> lo genera BaseLayout, así que un estilo scoped no lo alcanzaría.
     Como este <style> está en about.astro, solo se carga en esta página. */
  h1 {
    color: #c01a26;
    font-size: 4rem;
  }

  .habilidades {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .habilidades li {
    background-color: #f0f0f0;
    border-radius: 4px;
    padding: 0.25rem 0.75rem;
    font-size: 0.9rem;
    color: var(--colorHabilidad);
    font-weight: var(--pesoHabilidad);
    text-transform: var(--mayusculas);
  }
</style>
